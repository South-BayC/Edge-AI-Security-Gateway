# 本地构建/部署配置（复制为 config.mk 后按需修改；config.mk 不入 git）
#
#   cp config.mk.example config.mk
#
# 路径均为开发机（VM）上的绝对路径。

# NFS rootfs（板端通过 NFS 挂载的根文件系统）
NFS_ROOT  := /home/szh/linux/nfs/rootfs

# TFTP 目录（存放 dtb）
TFTP_DIR  := /home/szh/linux/tftp

# 交叉编译工具链前缀（默认即可）
# CROSS_COMPILE := arm-linux-gnueabihf-

# ncnn / mbedTLS 预编译目录（相对 core/lvgl，一般不用改）
# NCNN_DIR    := ../../third_party/ncnn-armhf
# MBEDTLS_DIR := ../../third_party/mbedtls-armhf
